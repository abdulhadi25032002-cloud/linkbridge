# LinkBridge environment configuration
# Copy to .env and fill in real values. Never commit .env files.

# --- Server ---
PORT=8080
NODE_ENV=development

# --- PostgreSQL ---
DATABASE_URL=postgres://linkbridge:linkbridge_dev@localhost:5432/linkbridge

# --- Security secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=change-me-access-secret-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- CORS / host config ---
WEB_ORIGIN=http://localhost:5173
PAIRING_BASE_URL=http://localhost:5173
# Base URL the Android deep link resolves against when the pairing QR/link is opened.

# --- TURN relay (production). Leave empty to disable relay candidates. ---
TURN_URL=turn:your-turn.example.com:3478
TURN_USERNAME=linkbridge
TURN_SECRET=change-me-turn-shared-secret

# --- Admin bootstrap account (created on first run if no users exist) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# --- Android app link host used to build pairing deep links ---
APP_LINK_HOST=pair.linkbridge.example
